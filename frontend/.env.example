# Build-time public settings. Empty DSN disables browser telemetry.
VITE_API_BASE=http://localhost:8787/api/v1/games/005a544d454d4f01
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Use the same release identifier for frontend and backend (e.g. git SHA).
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.05
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1

# Optional build-only private upload credentials: NEVER use a VITE_ prefix.
# Upload is opt-in; it fails the build if any required value is missing.
SENTRY_UPLOAD_SOURCEMAPS=false
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
