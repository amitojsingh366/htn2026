{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htn2026-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "secrets": {
    "required": [
      "ZT_GATEWAY_TOKEN",
      "ZT_HOST_MAC"
    ]
  },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "SENTRY_DSN": "",
    "SENTRY_ENVIRONMENT": "production",
    "SENTRY_RELEASE": "",
    "SENTRY_TRACES_SAMPLE_RATE": "0.1"
  }
}
