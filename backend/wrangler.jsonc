{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htn2026-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
